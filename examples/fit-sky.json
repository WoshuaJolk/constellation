{
  "description": "Independent one-pixel flux/count control; not an astronomical discovery or the full FitSky solution.",
  "scene": {
    "source_types": [
      {
        "name": "star",
        "kind": "star",
        "parameters": {
          "x": [0, 0],
          "y": [0, 0],
          "flux": [1, 3]
        }
      }
    ],
    "exposures": [
      {
        "id": "synthetic-control",
        "instrument": "default",
        "time": 0,
        "data": [[1]],
        "psf_sigma": 0.6,
        "noise_sigma": 1
      }
    ],
    "count_prior": {"probabilities": [0.5, 0.5]}
  },
  "queries": ["count=0", "has:star", "any:star:flux:1:2"]
}
