SELECT source_id,ref_epoch,ra,dec,parallax,pmra,pmdec,ra_error,dec_error,parallax_error,pmra_error,pmdec_error,ra_dec_corr,ra_parallax_corr,ra_pmra_corr,ra_pmdec_corr,dec_parallax_corr,dec_pmra_corr,dec_pmdec_corr,parallax_pmra_corr,parallax_pmdec_corr,pmra_pmdec_corr,radial_velocity,radial_velocity_error,rv_nb_transits,ruwe,astrometric_excess_noise,duplicated_source,phot_g_mean_mag,bp_rp FROM gaiadr3.gaia_source WHERE parallax > 0.15 AND parallax_over_error > 10 AND ruwe < 1.4 AND duplicated_source = 'false' AND (4.74047*SQRT(pmra*pmra+pmdec*pmdec)/parallax > 400 OR ABS(radial_velocity) > 400)
