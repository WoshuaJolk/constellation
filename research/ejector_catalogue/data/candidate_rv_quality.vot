</PARAM>
<PARAM name="ISSUES" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia-users/known-issues">
<DESCRIPTION>Known issues in the data:</DESCRIPTION>
</PARAM>
<PARAM name="DATA" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia/data-access">
<DESCRIPTION>Gaia data:</DESCRIPTION>
</PARAM>
<PARAM name="TERMS" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/esdc/terms-and-conditions">
<DESCRIPTION>Terms and conditions for use of Gaia data:</DESCRIPTION>
</PARAM>
<PARAM name="HOME" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia">
<DESCRIPTION>Gaia mission home:</DESCRIPTION>
</PARAM>
<PARAM name="PUBLISHER" ucd="meta.id;meta.curation" datatype="char" arraysize="*" value="ESA/Gaia/DPAC">
<DESCRIPTION>Dataset publisher</DESCRIPTION>
</PARAM>
<PARAM name="CREATOR" ucd="meta.ref" datatype="char" arraysize="*" value="Gaia Collaboration">
<DESCRIPTION>Dataset creator</DESCRIPTION>
</PARAM>


<TABLE>
<FIELD ID="SOURCE_ID" datatype="long" name="source_id" ucd="meta.id">
<DESCRIPTION>Unique source identifier (unique within a particular Data Release)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="rv_expected_sig_to_noise" ucd="stat.snr">
<DESCRIPTION>Expected signal to noise ratio in the combination of the spectra used to obtain the radial velocity</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="rv_template_teff" ucd="stat.fit.param" unit="K">
<DESCRIPTION>Teff of the template used to compute the radial velocity</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="rv_method_used" ucd="meta.code.class">
<DESCRIPTION>Method used to obtain the radial velocity</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="rv_nb_transits" ucd="meta.number">
<DESCRIPTION>Number of transits used to compute the radial velocity</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="grvs_mag" ucd="phot.mag;em.opt" unit="mag" utype="stc:AstroCoords.Velocity3D.Value3.C3">
<DESCRIPTION>Integrated Grvs magnitude</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="rv_chisq_pvalue" ucd="stat.fit.param">
<DESCRIPTION>P-value for constancy based on a chi-squared criterion</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="rv_renormalised_gof" ucd="stat.fit.goodness">
<DESCRIPTION>Radial velocity renormalised goodness of fit</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="rv_nb_deblended_transits" ucd="meta.number">
<DESCRIPTION>Number of valid transits that have undergone deblending</DESCRIPTION>
</FIELD>
