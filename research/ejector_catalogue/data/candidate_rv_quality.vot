<INFO name="QUERY" value="SELECT source_id,rv_expected_sig_to_noise,rv_template_teff,rv_method_used,rv_nb_transits,grvs_mag,rv_chisq_pvalue,rv_renormalised_gof,rv_nb_deblended_transits FROM gaiadr3.gaia_source WHERE source_id IN (1061822400696509696,140319815672187008,1451976542670188160,1841257466253265152,2364812051194680448,2364812055490127488,2381856890901926272,301461594138594304,3456028692671842944,384561583453755136,4100670779516921088,4135621848968014208,4286540986806313472,451427180510779136,4979220221218050432,5129921587022433920,5166063908616390272,5331557897713152640,5361412284105218816,5553405156250025088,6065148413638143360,6266029394177561088,6395326738923518976,71309655549854080,958663883317793920)" ucd="meta.query"/>

<PARAM name="CITATION" ucd="meta.bib" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia-users/credits">
<DESCRIPTION>How to cite and acknowledge Gaia:</DESCRIPTION>
</PARAM>
<PARAM name="RELEASE" ucd="meta.version" datatype="char" arraysize="*" value="Gaia DR3">
<DESCRIPTION>Gaia data release</DESCRIPTION>
</PARAM>
<PARAM name="HELP" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia-users/archive">
