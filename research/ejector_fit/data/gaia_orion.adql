SELECT source_id,ref_epoch,ra,dec,parallax,parallax_error,pmra,pmra_error,pmdec,pmdec_error,parallax_pmra_corr,parallax_pmdec_corr,pmra_pmdec_corr,ruwe,phot_g_mean_mag FROM gaiadr3.gaia_source WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',79.07562221034,34.31231789,0.001)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',86.49956259956,-32.30643396161,0.001)) OR 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',83.858275805,-5.9098885235,0.001))
